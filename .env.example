# ===========================================================
#  네이버 블로그 자동 포스팅 - 환경설정
#  이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# ===========================================================

# -----------------------------------------------------------
# 1) 텍스트 AI 제공자
# -----------------------------------------------------------

# myGenAssist 를 사용하려면 mygenassist, Google Gemini 를 사용하려면 gemini
AI_PROVIDER=mygenassist

# Gemini 선택 시 Google AI Studio (https://aistudio.google.com/app/apikey) 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# myGenAssist 선택 시에만 사용
AI_BASE_URL=https://chat.int.bayer.com/api/v3

# myGenAssist 웹 > 설정 > API Key 에서 발급받은 토큰
AI_API_KEY=

# 인증 헤더 (스펙의 APIKeyHeader)
AI_AUTH_HEADER=x-baychatgpt-accesstoken

# 사용할 엔드포인트: agent(웹검색 가능) 또는 responses
AI_ENDPOINT=agent

# myGenAssist 모델명. 게이트웨이가 실제로는 gpt-5-mini 같은 추론 모델로 라우팅할 수 있습니다.
# 추론 모델은 토큰 한도를 추론에 먼저 쓰므로 max_tokens 를 넉넉히 잡아야 합니다.
AI_CHAT_MODEL=claude-sonnet-4-5

# 트렌드 조사에 웹검색 도구를 사용할지 여부
# Gemini 에서는 Google Search grounding 을 사용합니다.
AI_USE_WEBSEARCH=true

# 사내 API 가 JSON 모드를 지원하지 않으면 false 로 바꾸세요.
AI_SUPPORTS_JSON_MODE=true

# 사내망 프록시가 필요하면 입력
HTTP_PROXY=
HTTPS_PROXY=

# 사내망 SSL 검사는 truststore 패키지가 자동으로 처리합니다.
# 이 값은 그래도 안 될 때 쓰는 최후 수단이며, 켜두는 것을 권장합니다.
AI_VERIFY_SSL=true


# -----------------------------------------------------------
# 2) 이미지 소스 (무료 스톡 이미지)
# -----------------------------------------------------------

# pexels 또는 unsplash
IMAGE_PROVIDER=pexels

# https://www.pexels.com/api/ 에서 무료 발급
PEXELS_API_KEY=

# https://unsplash.com/developers 에서 무료 발급
UNSPLASH_ACCESS_KEY=

# 포스팅 한 건당 내려받을 스톡 이미지 개수
IMAGE_COUNT=4


# -----------------------------------------------------------
# 2-1) AI 이미지 생성 (선택)
#      Bayer myGenAssist API 에는 이미지 생성 기능이 없습니다.
#      아래를 채우면 켜지고, 비워두면 자동으로 비활성화됩니다.
#      우선순위상 상세페이지/스톡 이미지로 채워지지 않은 슬롯에만 쓰입니다.
# -----------------------------------------------------------

# OpenAI 호환 규격이면 그대로 붙습니다. 예: https://api.openai.com/v1
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_AUTH_HEADER=Authorization
IMAGE_GEN_AUTH_PREFIX=Bearer
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_SIZE=1024x1024


# -----------------------------------------------------------
# 2-2) 품질 기준
# -----------------------------------------------------------

# 이 점수 미만이면 지적 사항을 고쳐 다시 평가합니다.
QUALITY_PASS_MARK=80

# 최대 시도 횟수. 늘리면 품질은 오르지만 시간과 비용이 늘어납니다.
QUALITY_MAX_ATTEMPTS=3

# AI 문체를 계측해 사람 글처럼 다듬는 단계를 쓸지 여부
HUMANIZE=true


# -----------------------------------------------------------
# 2-3) 글 작성 방식
# -----------------------------------------------------------

# staged=단계별 집필(사실 정리→메시지→개요→섹션 집필→통일→검수→부분 수정), legacy=예전 방식
# 위의 QUALITY_* / HUMANIZE 는 legacy 에서 쓰인다.
WRITER_MODE=staged

# 한 번의 AI 호출로 쓸 섹션 수. 늘리면 호출 수는 줄고 섹션별 집중도는 떨어진다.
STAGED_SECTION_BATCH=3

# 검수에 걸린 문장을 고치는 최대 횟수
STAGED_MAX_FIX_ROUNDS=2

# false 면 AI 검수 없이 코드 검사(과장·압박·체험 단정·근거 없는 수치·키워드·가독성)만 한다
STAGED_AI_REVIEW=true


# -----------------------------------------------------------
# 3) 네이버 계정
# -----------------------------------------------------------
NAVER_ID=
NAVER_PW=

# 블로그 주소가 blog.naver.com/abcd1234 이면 abcd1234
NAVER_BLOG_ID=

# 글을 올릴 카테고리 이름 (비우면 이슈상품)
NAVER_CATEGORY=이슈상품

# 발행 창에서 고를 주제 (비우면 상품리뷰)
NAVER_SUBJECT=상품리뷰


# -----------------------------------------------------------
# 4) 포스팅 옵션
# -----------------------------------------------------------

# draft(임시저장) 또는 publish(바로 발행)
POST_MODE=publish

# 브라우저 창 표시 여부. 캡차 대응을 위해 true 권장
BROWSER_HEADED=true

# 업로드 전 HTML 미리보기·수정 제안 단계. false 면 묻지 않고 바로 올린다
REVIEW_BEFORE_UPLOAD=false

# 공정위 필수 대가성 문구 (쇼핑 커넥트 이용 시 반드시 필요)
DISCLOSURE_TEXT=이 글에는 쇼핑 커넥트 상품이 포함되어 있으며, 상품 판매 시 크리에이터는 수수료를 받습니다.

# 쇼핑 커넥트 상품 카드의 creatorSpaceId. 크리에이터마다 고정값이다.
# 내 블로그에 올라간 쇼핑 커넥트 글에서 상품 카드를 검사하면 data-linkdata 안에 보인다.
NAVER_CREATOR_SPACE_ID=

# 블로그 글의 말투 / 페르소나
BLOG_PERSONA=30대 직장인, 솔직하고 담백한 리뷰어 말투. 과장 광고 표현은 쓰지 않음.


# -----------------------------------------------------------
# 5) 티스토리 — 구글 검색용
#    네이버에 올린 같은 원고를 여기에도 올린다.
#    쇼핑 커넥트 카드는 네이버 전용이라, 티스토리 본문에는 구매 버튼이 들어간다.
#    버튼 주소는 제휴 링크 그대로다.
# -----------------------------------------------------------

# 블로그 주소가 https://wkkim97.tistory.com 이면 wkkim97
TISTORY_BLOG_NAME=wkkim97

# 글을 넣을 카테고리 이름. 관리 화면의 이름과 같아야 한다.
TISTORY_CATEGORY=이슈상품 모음

# 3=공개(구글 검색 대상), 0=비공개. 비우면 POST_MODE 를 따른다.
# 네이버는 draft 로 두고 티스토리만 공개할 수 있다.
TISTORY_VISIBILITY=3

# full=네이버와 같은 원고(글·사진·구매 버튼), link=네이버 글 링크만(예전 방식)
TISTORY_CONTENT=full

# draft=임시저장만(발행은 티스토리 관리 화면에서 직접), publish=바로 발행
TISTORY_POST_MODE=draft
